# Copy this file to .env and fill in your own values:   cp .env.example .env
# .env is in .gitignore: your keys stay on your computer and never go to GitHub.
# Find each endpoint and key in the Azure portal → your resource → "Keys and Endpoint".

# Document Intelligence (Free F0)
AZURE_DOCINTEL_ENDPOINT=https://<your-docintel-name>.cognitiveservices.azure.com/
AZURE_DOCINTEL_KEY=<your-docintel-key>

# AI Search (Free tier)
AZURE_SEARCH_ENDPOINT=https://<your-search-name>.search.windows.net
AZURE_SEARCH_KEY=<your-search-admin-key>

# Azure OpenAI in Microsoft Foundry (the "Azure OpenAI" endpoint of your Foundry resource)
AZURE_OPENAI_ENDPOINT=https://<your-foundry-name>.openai.azure.com/
AZURE_OPENAI_KEY=<your-foundry-key>
# The names you gave your two model deployments
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# Part 2: the .NET API with the bills tools (TrunkTools/), started with `dotnet run`
TRUNK_TOOLS_URL=http://localhost:5085
